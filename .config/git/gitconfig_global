[alias]
		# [a]dd[c]ommit[p]ush
	acp     = "!sh -c 'git add . && git commit -am \"quick commit\" && git push'"
		# [a]dd[c]ommit[p]ush[n]o[v]erify
	acpnv   = "!sh -c 'git add . && git commit -am \"quick commit\" --no-verify && git push'"
	co      = checkout
	cnv     = commit --no-verify
		# empty commit
	empty   = "!git commit --allow-empty --no-verify -m 'empty commit' && git push"
	f       = fetch --all
	st      = stash --include-untracked
	lg      = log --oneline
		# interactive selection for branches
		# NOTE: @joeyagreco - this sorts by the last time i checked out the branch
	br      = "!f() { branch=$({ git for-each-ref --format='b%(HEAD) %(refname:short)' refs/heads; git reflog --format=%gs | sed -n 's/^checkout: moving from .* to /c /p'; git for-each-ref --format='c %(refname:short)' refs/heads; } | awk '$1==\"b\"{ok[$2]=1; next} $1==\"c\" && ok[$2] && !seen[$2]++ {print $2}' | fzf --no-multi); [ -n \"$branch\" ] && git checkout \"$branch\"; }; f"

[branch]
    sort = -committerdate

[color]
	# use colors in git commands that are capable of colored output when
	# outputting to the terminal. (this is the default setting in git ≥ 1.8.4.)
	ui = auto

[commit]
	# don't include git default commit template
	status = false
	template = ~/.config/git/commit_template.txt

[core]
	editor = vim
	# speeds up git status
	untrackedCache = true

[maintenance]
    auto = true
    strategy = incremental

[pull]
	rebase = true

[push]
	autoSetupRemote = true

